.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.04);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 22rpx;
  position: relative;
}
.tab-item.active {
  color: #2D9AFF;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}
.tab-text {
  line-height: 1;
}