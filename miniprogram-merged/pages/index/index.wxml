<view class="page">
  <view class="header">
    <view class="title">陪诊服务</view>
    <view class="subtitle">专业陪同就医 · 全程留痕可追溯</view>
  </view>

  <view class="notice" wx:if="{{notice}}">
    <text class="notice-icon">📢</text>
    <text class="notice-text">{{notice}}</text>
  </view>

  <view class="quick">
    <view class="quick-card" bindtap="goPatients">
      <view class="quick-icon">👤</view>
      <view class="quick-body">
        <view class="quick-title">就医人管理</view>
        <view class="quick-sub">为家人建档</view>
      </view>
    </view>
    <view class="quick-card" bindtap="goOrders">
      <view class="quick-icon">📋</view>
      <view class="quick-body">
        <view class="quick-title">我的订单</view>
        <view class="quick-sub">查看预约进度</view>
      </view>
    </view>
  </view>

  <scroll-view class="cat-bar" scroll-x>
    <view
      class="cat {{activeCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{loading && !packages.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!packages.length}}" class="empty">
    <view class="empty-title">暂无可预约的服务项目</view>
    <view class="empty-tip">下拉刷新试试</view>
  </view>

  <view class="pkg-card" wx:for="{{packages}}" wx:key="id" data-id="{{item.id}}" bindtap="goPackage">
    <view class="pkg-main">
      <view class="pkg-name">{{item.name}}</view>
      <view class="pkg-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="pkg-tags">
        <text class="tag" wx:if="{{item.duration_minutes}}">约 {{item.duration_minutes}} 分钟</text>
        <text class="tag" wx:if="{{item.requires_family_consent}}">需家属授权</text>
      </view>
    </view>
    <view class="pkg-right">
      <view class="pkg-price">¥{{item.price}}</view>
      <view class="pkg-btn">预约</view>
    </view>
  </view>

  <view class="safe-bottom" />
</view>
