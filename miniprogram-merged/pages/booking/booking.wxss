.page {
  min-height: 100vh;
  background: #f5f6f7;
  box-sizing: border-box;
}

.pkg-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(160deg, #2d9aff 0%, #1f7fe0 100%);
  color: #fff;
  padding: 32rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.pkg-name { font-size: 32rpx; font-weight: 500; }
.pkg-price { font-size: 40rpx; font-weight: 600; color: #fff3d6; }

.section {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 26rpx 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1f2b;
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.link { font-size: 26rpx; color: #2d9aff; font-weight: 400; }
.hint { font-size: 26rpx; color: #b0b6bf; padding: 18rpx 0 28rpx; }

.picker-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.picker-row:last-child { border-bottom: none; }
.picker-label { font-size: 28rpx; color: #666; width: 160rpx; }
.picker-value { flex: 1; font-size: 28rpx; color: #1a1f2b; text-align: right; }
.arrow { margin-left: 14rpx; color: #c3c8d0; font-size: 32rpx; }

.chip-row { display: flex; flex-wrap: wrap; padding-bottom: 16rpx; }
.chip {
  font-size: 26rpx;
  color: #4a5262;
  background: #f2f4f7;
  border-radius: 32rpx;
  padding: 12rpx 30rpx;
  margin: 0 16rpx 16rpx 0;
}
.chip.active { background: #e8f3ff; color: #2d9aff; border: 1rpx solid #2d9aff; }

.textarea {
  background: #f5f6f7;
  border-radius: 12rpx;
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.boundary-box {
  max-height: 300rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}
.b-title { font-size: 26rpx; color: #1a1f2b; font-weight: 500; margin-bottom: 8rpx; }
.b-title.mt { margin-top: 16rpx; }
.b-item { font-size: 24rpx; color: #5b6472; line-height: 1.7; }
.b-item.forbid { color: #a35c5c; }

.agree-row { display: flex; align-items: center; padding: 10rpx 0 26rpx; }
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #c3c8d0;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
}
.checkbox.checked { background: #2d9aff; border-color: #2d9aff; }
.agree-text { font-size: 26rpx; color: #4a5262; }

.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.footer-price { font-size: 40rpx; color: #ff5f2e; font-weight: 600; flex: 1; }
.footer-btn {
  width: 320rpx;
  background: #2d9aff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
.footer-btn[disabled] { opacity: 0.6; }
.btn-primary { background: #2d9aff; color: #fff; }

.safe-bottom2 { height: 180rpx; }
