.page {
  min-height: 100vh;
  background: #f5f6f7;
  box-sizing: border-box;
}

.empty { padding: 160rpx 0; text-align: center; color: #999; font-size: 28rpx; }

.head {
  background: linear-gradient(160deg, #2d9aff 0%, #1f7fe0 100%);
  color: #fff;
  padding: 36rpx 32rpx 40rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.head-no { font-size: 23rpx; opacity: 0.8; }
.head-svc { margin-top: 10rpx; font-size: 34rpx; font-weight: 600; }
.head-meta { margin-top: 10rpx; font-size: 25rpx; opacity: 0.92; line-height: 1.6; }

.section {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 26rpx;
}
.section-title { font-size: 30rpx; font-weight: 500; color: #1a1f2b; margin-bottom: 18rpx; }

.node-grid { display: flex; flex-wrap: wrap; }
.node {
  width: 48%;
  display: flex;
  align-items: center;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin: 0 4% 16rpx 0;
  box-sizing: border-box;
}
.node:nth-child(2n) { margin-right: 0; }
.node.done { background: #e8f6ee; }
.node-mark { margin-right: 12rpx; color: #b0b6bf; font-size: 26rpx; }
.node.done .node-mark { color: #2f9e5f; }
.node-label { font-size: 26rpx; color: #4a5262; }
.node.done .node-label { color: #2f9e5f; }
.node-tip { margin-top: 4rpx; font-size: 23rpx; color: #b0b6bf; line-height: 1.6; }

.log-item {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}
.log-head { display: flex; justify-content: space-between; align-items: center; }
.log-node { font-size: 27rpx; color: #1a1f2b; font-weight: 500; }
.log-node.correction { color: #8a6d1f; }
.log-time { font-size: 22rpx; color: #98a1ad; }
.log-loc { margin-top: 8rpx; font-size: 23rpx; color: #7a828e; }
.log-remark { margin-top: 8rpx; font-size: 24rpx; color: #5b6472; line-height: 1.6; }
.log-flag { margin-top: 8rpx; font-size: 23rpx; color: #c9803a; }
.log-ops { margin-top: 10rpx; text-align: right; }
.corr-btn { font-size: 24rpx; color: #2d9aff; }

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 100;
  max-height: 88vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1f2b;
  text-align: center;
  margin-bottom: 28rpx;
}
.sheet-tip { font-size: 23rpx; color: #b0b6bf; line-height: 1.6; margin-bottom: 22rpx; }

.field { margin-bottom: 26rpx; }
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.input {
  background: #f5f6f7;
  border-radius: 12rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.textarea {
  background: #f5f6f7;
  border-radius: 12rpx;
  width: 100%;
  height: 150rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.photo-row { display: flex; flex-wrap: wrap; }
.photo {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx 16rpx 0;
}
.photo image { width: 100%; height: 100%; }
.photo-del {
  position: absolute;
  right: 0; top: 0;
  width: 40rpx; height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
  border-radius: 0 0 0 12rpx;
}
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #c3c8d0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #c3c8d0;
}

.sheet-ops { display: flex; margin-top: 6rpx; }
.sheet-ops .btn-ghost { margin-right: 20rpx; width: 200rpx; }
.btn-ghost {
  background: #f2f4f7;
  color: #4a5262;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
.btn-primary {
  background: #2d9aff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
.btn-primary[disabled] { opacity: 0.6; }
.flex1 { flex: 1; }

.safe-bottom { height: 60rpx; }
