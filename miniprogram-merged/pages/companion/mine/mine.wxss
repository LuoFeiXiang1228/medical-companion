.page {
  min-height: 100vh;
  background: #f5f6f7;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  background: linear-gradient(160deg, #2d9aff 0%, #1f7fe0 100%);
  color: #fff;
  padding: 44rpx 32rpx 48rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 24rpx;
}
.head-info { flex: 1; }
.name { font-size: 36rpx; font-weight: 600; }
.sub { margin-top: 8rpx; font-size: 24rpx; opacity: 0.9; }
.audit-chip {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
}
.audit-chip.ok { background: #e8f6ee; color: #2f9e5f; }
.audit-chip.bad { background: #fdecec; color: #c05555; }

.section {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 26rpx;
}
.section-title { font-size: 30rpx; font-weight: 500; color: #1a1f2b; margin-bottom: 16rpx; }

.kv { display: flex; margin-bottom: 12rpx; }
.k { width: 200rpx; font-size: 26rpx; color: #98a1ad; }
.v { flex: 1; font-size: 26rpx; color: #1a1f2b; }
.v.warn { color: #c05555; }

.reason { font-size: 25rpx; color: #a06a1f; line-height: 1.8; }

.stat-row { display: flex; }
.stat { flex: 1; text-align: center; }
.num { font-size: 40rpx; color: #2d9aff; font-weight: 600; }
.lab { margin-top: 6rpx; font-size: 24rpx; color: #98a1ad; }

.menu {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 6rpx 26rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon { margin-right: 18rpx; font-size: 34rpx; }
.mi-text { flex: 1; font-size: 28rpx; color: #1a1f2b; }
.mi-arrow { color: #c3c8d0; font-size: 32rpx; }

.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6bf;
}

.safe-bottom { height: 60rpx; }
