<view class="page">
  <view wx:if="{{loading && !list.length}}" class="empty">加载中…</view>

  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-title">还没有就医人档案</view>
    <view class="empty-tip">添加后即可为家人预约陪诊服务</view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="card-main">
      <view class="name-row">
        <text class="name">{{item.real_name}}</text>
        <text class="badge" wx:if="{{item.is_default}}">默认</text>
      </view>
      <view class="meta">
        <text wx:if="{{item.relationLabel}}">{{item.relationLabel}}</text>
        <text wx:if="{{item.phone}}"> · {{item.phone}}</text>
      </view>
    </view>
    <view class="card-ops">
      <text class="op-del" data-id="{{item.id}}" bindtap="remove">删除</text>
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="openForm">＋ 添加就医人</button>
  </view>

  <view class="mask" wx:if="{{showForm}}" bindtap="closeForm"></view>
  <view class="sheet" wx:if="{{showForm}}">
    <view class="sheet-title">添加就医人</view>

    <view class="field">
      <text class="label">姓名 *</text>
      <input class="input" placeholder="就医人姓名" value="{{form.name}}" data-key="name" bindinput="onField" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="就医人联系电话（选填）" value="{{form.phone}}" data-key="phone" bindinput="onField" />
    </view>
    <view class="field">
      <text class="label">与我的关系</text>
      <view class="chip-row">
        <view
          class="chip {{form.relation === item.value ? 'active' : ''}}"
          wx:for="{{relations}}"
          wx:for-item="item"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickRelation"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">行动能力</text>
      <view class="chip-row">
        <view
          class="chip {{form.mobility === item.value ? 'active' : ''}}"
          wx:for="{{mobilityOptions}}"
          wx:for-item="item"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="pickMobility"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">健康备注</text>
      <textarea class="textarea" placeholder="如：听力不佳、需备轮椅等（选填）" value="{{form.healthNote}}" data-key="healthNote" bindinput="onField" maxlength="500" />
    </view>
    <view class="field row">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault}}" bindchange="toggleDefault" color="#2D9AFF" />
    </view>

    <view class="sheet-ops">
      <button class="btn-ghost" bindtap="closeForm">取消</button>
      <button class="btn-primary flex1" bindtap="submit" disabled="{{loading}}">保存</button>
    </view>
  </view>

  <view class="safe-bottom" />
</view>
