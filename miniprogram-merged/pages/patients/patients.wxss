.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.empty-title { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.empty-tip { font-size: 24rpx; color: #aaa; }

.card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.card-main { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; }
.name { font-size: 32rpx; color: #1a1f2b; font-weight: 500; }
.badge {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #2d9aff;
  border: 1rpx solid #2d9aff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.meta { margin-top: 10rpx; font-size: 26rpx; color: #8a919c; }
.card-ops { padding-left: 20rpx; }
.op-del { font-size: 26rpx; color: #e05656; }

.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.btn-primary {
  background: #2d9aff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
.btn-primary[disabled] { opacity: 0.6; }
.btn-ghost {
  background: #f2f4f7;
  color: #4a5262;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}
.flex1 { flex: 1; }

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 100;
  max-height: 88vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1f2b;
  text-align: center;
  margin-bottom: 28rpx;
}

.field { margin-bottom: 28rpx; }
.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 14rpx; }
.input {
  background: #f5f6f7;
  border-radius: 12rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.textarea {
  background: #f5f6f7;
  border-radius: 12rpx;
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.chip-row { display: flex; flex-wrap: wrap; }
.chip {
  font-size: 26rpx;
  color: #4a5262;
  background: #f2f4f7;
  border-radius: 32rpx;
  padding: 12rpx 30rpx;
  margin: 0 16rpx 16rpx 0;
}
.chip.active { background: #e8f3ff; color: #2d9aff; border: 1rpx solid #2d9aff; }

.sheet-ops { display: flex; margin-top: 12rpx; }
.sheet-ops .btn-ghost { margin-right: 20rpx; width: 200rpx; }

.safe-bottom { height: 140rpx; }
