<view class="page">
  <view class="tabs">
    <view class="tab {{type === 'privacy' ? 'active' : ''}}" data-type="privacy" bindtap="switchType">隐私政策</view>
    <view class="tab {{type === 'agreement' ? 'active' : ''}}" data-type="agreement" bindtap="switchType">用户协议</view>
  </view>

  <view class="body">
    <view class="doc-title">{{title}}（默认版本）</view>
    <text class="doc-text">{{body}}</text>
  </view>
</view>
