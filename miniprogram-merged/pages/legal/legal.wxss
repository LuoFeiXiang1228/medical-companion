.page {
  min-height: 100vh;
  background: #fff;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  background: #f5f6f7;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 10rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #4a5262;
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.tab.active { background: #fff; color: #2d9aff; font-weight: 500; }

.body { padding: 8rpx 36rpx 40rpx; }
.doc-title { font-size: 34rpx; font-weight: 600; color: #1a1f2b; margin-bottom: 24rpx; }
.doc-text { font-size: 27rpx; color: #4a5262; line-height: 2; white-space: pre-wrap; }
