.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 30rpx; font-weight: 500; color: #1a1f2b; margin-bottom: 16rpx; }

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.k { width: 180rpx; font-size: 27rpx; color: #98a1ad; }
.v { flex: 1; font-size: 27rpx; color: #1a1f2b; }
.v.muted { color: #b0b6bf; }
.note { margin-top: 16rpx; font-size: 25rpx; color: #5b6472; line-height: 1.8; }

.qa { margin-bottom: 22rpx; }
.q { font-size: 27rpx; color: #1a1f2b; font-weight: 500; margin-bottom: 8rpx; }
.a { font-size: 25rpx; color: #5b6472; line-height: 1.8; }
