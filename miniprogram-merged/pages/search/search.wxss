.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.search-bar { display: flex; align-items: center; }
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 44rpx;
  height: 84rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 20rpx;
  background: #2d9aff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  padding: 20rpx 40rpx;
}

.empty { padding: 140rpx 0; text-align: center; color: #999; font-size: 28rpx; }
.empty-title { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.empty-tip { font-size: 24rpx; color: #aaa; }

.pkg-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}
.pkg-main { flex: 1; min-width: 0; }
.pkg-name { font-size: 31rpx; color: #1a1f2b; font-weight: 500; }
.pkg-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8a919c;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.pkg-price { font-size: 32rpx; color: #ff5f2e; font-weight: 600; padding-left: 16rpx; }
