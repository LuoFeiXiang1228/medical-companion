.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 26rpx;
  margin-bottom: 24rpx;
}
.card.center {
  display: flex;
  justify-content: center;
  padding: 40rpx 26rpx 36rpx;
}

.avatar-wrap {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-wrap::after { border: none; }
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eef1f5;
}
.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.avatar-tip { margin-top: 16rpx; font-size: 24rpx; color: #98a1ad; }

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.row:last-child { border-bottom: none; }
.k { width: 160rpx; font-size: 28rpx; color: #666; }
.v { flex: 1; font-size: 28rpx; color: #1a1f2b; }
.arrow { color: #c3c8d0; font-size: 32rpx; }

.mini-btn {
  margin: 0;
  background: #e8f3ff;
  color: #2d9aff;
  font-size: 24rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  line-height: 58rpx;
  height: 58rpx;
}

.tip {
  font-size: 23rpx;
  color: #b0b6bf;
  line-height: 1.8;
  padding: 0 8rpx;
}
