<view class="page">
  <view class="card center">
    <button class="avatar-wrap" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatar}}" wx:if="{{avatar}}" />
      <view class="avatar placeholder" wx:else>👤</view>
      <view class="avatar-tip">点击更换头像</view>
    </button>
  </view>

  <view class="card">
    <view class="row" bindtap="editNickname">
      <text class="k">昵称</text>
      <text class="v">{{profile.nickname || '未设置'}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="row">
      <text class="k">手机号</text>
      <text class="v">{{profile.phone || '未绑定'}}</text>
      <button class="mini-btn" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" wx:if="{{!profile.phone}}">去绑定</button>
    </view>
  </view>

  <view class="tip">说明：手机号绑定需正式小程序环境（测试号不可用）；头像与昵称仅用于页面展示。</view>
</view>
