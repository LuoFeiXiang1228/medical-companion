.page {
  min-height: 100vh;
  background: #f5f6f7;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(160deg, #2d9aff 0%, #1f7fe0 100%);
  color: #fff;
  padding: 48rpx 32rpx 52rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.25);
}
.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.user-info { flex: 1; }
.nick { font-size: 36rpx; font-weight: 600; }
.phone { margin-top: 10rpx; font-size: 25rpx; opacity: 0.9; }

.menu {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 6rpx 26rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon { margin-right: 18rpx; font-size: 34rpx; }
.mi-text { flex: 1; font-size: 29rpx; color: #1a1f2b; }
.mi-arrow { color: #c3c8d0; font-size: 32rpx; }

.version {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6bf;
}

.safe-bottom { height: 60rpx; }
