<view class="page">
  <view class="user-card">
    <image class="avatar" src="{{avatar}}" wx:if="{{avatar}}" />
    <view class="avatar placeholder" wx:else>👤</view>
    <view class="user-info">
      <view class="nick">{{profile.nickname || '微信用户'}}</view>
      <view class="phone">{{profile.phone || '未绑定手机号'}}</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goPatients"><text class="mi-icon">👤</text><text class="mi-text">就医人管理</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goOrders"><text class="mi-icon">📋</text><text class="mi-text">我的订单</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="contact"><text class="mi-icon">💬</text><text class="mi-text">联系客服</text><text class="mi-arrow">›</text></view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goCompanion">
      <text class="mi-icon">🩺</text>
      <text class="mi-text">{{companionLoggedIn ? '进入陪诊员工作台' : '陪诊员登录 / 注册'}}</text>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <view class="version">陪诊服务 v1.0.0</view>
  <view class="safe-bottom" />
</view>
