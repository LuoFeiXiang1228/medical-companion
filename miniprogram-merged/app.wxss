page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}
.flex { display: flex; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; align-items: center; }
.price { color: #fa3534; font-weight: 600; }
.muted { color: #999; }
.btn-primary {
  background: #3aa7ff;
  color: #fff;
  border-radius: 40rpx;
  text-align: center;
}
.btn-primary.disabled { background: #bdbdbd; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx;
}

