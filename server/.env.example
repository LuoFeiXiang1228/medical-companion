# 复制为 .env 后按实际环境填写；请勿提交真实密钥
NODE_ENV=development
PORT=3000

# 鉴权
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=7d

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=peizhen

# Redis（当前版本未使用，预留；不必填也能启动）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 演示版仅允许 mock；真实支付适配器未启用
PAY_CHANNEL=mock

# 微信登录需要有效 AppID / Secret；占位符只能启动服务，不能完成微信登录
WX_APPID=your_appid_here
WX_SECRET=your_secret_here
WX_MCH_ID=your_mchid_here
WX_MCH_KEY=your_wechatpay_api_key_here
# 支付回调地址（须与路由一致：/api/v1/orders/wxpay/callback）
WX_NOTIFY_URL=https://your-domain.com/api/v1/orders/wxpay/callback
# 微信支付下单 IP（留空默认 127.0.0.1）
WX_SPBILL_IP=

# 订单超时未支付自动取消（分钟）
ORDER_EXPIRE_MINUTES=5

# 服务地址
BASE_URL=http://localhost:3000
